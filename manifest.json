{
  "_comment": "pathbin manifest \u2014 declarative dev-tool install list. Edit freely; install.ps1 / install.sh consume this. via: scoop | winget | apt | custom (handler dispatched in script).",
  "scoop_buckets": [
    "main",
    "extras",
    "java",
    "nerd-fonts",
    "versions"
  ],
  "apt_repos": [
    {
      "id": "adoptium",
      "key_url": "https://packages.adoptium.net/artifactory/api/gpg/key/public",
      "list_line": "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb {CODENAME} main"
    },
    {
      "id": "github-cli",
      "key_url": "https://cli.github.com/packages/githubcli-archive-keyring.gpg",
      "list_line": "deb [arch={ARCH} signed-by=/etc/apt/keyrings/github-cli.gpg] https://cli.github.com/packages stable main"
    },
    {
      "id": "eza",
      "key_url": "https://raw.githubusercontent.com/eza-community/eza/main/deb.asc",
      "list_line": "deb [signed-by=/etc/apt/keyrings/eza.gpg] http://deb.gierens.de stable main"
    }
  ],
  "tools": [
    {
      "name": "git",
      "category": "vcs",
      "win": {
        "via": "scoop",
        "pkg": "main/git"
      },
      "linux": {
        "via": "apt",
        "pkg": "git"
      },
      "verify": "git --version"
    },
    {
      "name": "git-lfs",
      "category": "vcs",
      "win": {
        "via": "scoop",
        "pkg": "main/git-lfs"
