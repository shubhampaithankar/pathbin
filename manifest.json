      "id": "adoptium",
      "key_url": "https://packages.adoptium.net/artifactory/api/gpg/key/public",
      "list_line": "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb {CODENAME} main"
    },
    {
      "id": "github-cli",
      "key_url": "https://cli.github.com/packages/githubcli-archive-keyring.gpg",
      "list_line": "deb [arch={ARCH} signed-by=/etc/apt/keyrings/github-cli.gpg] https://cli.github.com/packages stable main"
